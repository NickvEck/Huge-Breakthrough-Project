## Multiplayer through SpacetimeDB. Autoload it as "Net".
## Connects on startup and keeps one [RemotePlayer] per other player's net_player row.
## The local player publishes through [method send_state], see [NetSyncComponent].
## A failed connection is reported once and the game keeps running offline.
## @warning: [code]SpacetimeDB.Faerie[/code] and [code]FaerieNetPlayer[/code] are generated by the
## SDK from the module in server/. Regenerate the schema after changing it.
extends Node

const HOST: String = "https://maincloud.spacetimedb.com"
const MODULE_NAME: String = "faerie"
const REMOTE_SCENE: PackedScene = preload("res://scenes/game/remote_playertest1.tscn")

# The generated module client. Untyped because codegen makes the class, and the only place that names it.
var _module
# Keyed by hex identity, a PackedByteArray is a poor dictionary key.
var _remotes: Dictionary[String, RemotePlayer] = { }
# Released remotes, hidden and disabled until the next join.
var _pool: Array[RemotePlayer] = []


func _ready() -> void:
	_module = SpacetimeDB.Faerie
	_module.connected.connect(_on_connected)
	_module.disconnected.connect(_on_disconnected)
	_module.connection_error.connect(_on_connection_error)
	var options := SpacetimeDBConnectionOptions.new()
	# A fresh identity per run, so two clients on one machine do not share a row.
	options.one_time_token = true
	_module.connect_db(HOST, MODULE_NAME, options)


# Leave cleanly so the server drops our row at once.
func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST and _module.is_connected_db():
		_module.disconnect_db()


## Publishes the local player's state. Does nothing while disconnected,
## the connection error was already reported.
func send_state(position: Vector3, flip: bool, animation: StringName) -> void:
	if not _module.is_connected_db():
		return
	var call: SpacetimeDBReducerCall = _module.reducers.update_net_player(position.x, position.y, position.z, flip, String(animation), GameState.get_current_level_path())
	if call.error != OK:
		push_error("net: update_net_player was not sent (%s)" % error_string(call.error))
		return
	call.on_error.connect(_on_reducer_error)


func _on_connected(_identity: PackedByteArray, _token: String) -> void:
	var subscription: SpacetimeDBSubscription = _module.subscribe(["SELECT * FROM net_player"])
	if subscription.error != OK:
		push_error("net: subscribe failed (%s)" % error_string(subscription.error))
		return
	subscription.applied.connect(_on_applied)


func _on_disconnected() -> void:
	push_warning("net: disconnected.")
	for id: String in _remotes.keys():
		_release(id)


func _on_connection_error(code: int, reason: String) -> void:
	push_error("net: connection failed (%d): %s" % [code, reason])


func _on_reducer_error(message: String) -> void:
	push_error("net: reducer failed: %s" % message)


# The local database is only guaranteed to exist once the subscription is applied.
# Register first, then iterate, so no row is missed. _apply is idempotent in case a
# row shows up in both.
func _on_applied() -> void:
	var table = _module.db.net_player
	table.on_insert(_apply)
	table.on_update(_on_updated)
	table.on_delete(_on_deleted)
	for row: FaerieNetPlayer in table.iter():
		_apply(row)


func _on_updated(_previous: FaerieNetPlayer, row: FaerieNetPlayer) -> void:
	_apply(row)


func _on_deleted(row: FaerieNetPlayer) -> void:
	var id: String = row.identity.hex_encode()
	if _remotes.has(id):
		_release(id)


# Insert and update are the same thing here: take a remote if missing, then apply.
func _apply(row: FaerieNetPlayer) -> void:
	if row.identity == _module.get_local_identity():
		return
	var id: String = row.identity.hex_encode()
	var remote: RemotePlayer = _remotes.get(id)
	if not remote:
		remote = _acquire()
		if not remote:
			return
		_remotes[id] = remote
	remote.apply(row)
	remote.visible = row.level == GameState.get_current_level_path()


func _acquire() -> RemotePlayer:
	if not _pool.is_empty():
		var pooled: RemotePlayer = _pool.pop_back()
		pooled.process_mode = Node.PROCESS_MODE_INHERIT
		pooled.reset()
		return pooled
	var remote := REMOTE_SCENE.instantiate() as RemotePlayer
	if not remote:
		push_error("net: %s root is not a RemotePlayer" % REMOTE_SCENE.resource_path)
		return null
	add_child(remote)
	return remote


func _release(id: String) -> void:
	var remote: RemotePlayer = _remotes[id]
	_remotes.erase(id)
	remote.visible = false
	remote.process_mode = Node.PROCESS_MODE_DISABLED
	_pool.append(remote)
